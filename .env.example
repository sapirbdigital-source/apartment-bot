# העתק ל-.env והשלם. ב-GitHub Actions אלה נכנסים כ-Secrets ולא כקובץ.

# --- Apify (סריקת קבוצות פייסבוק) ---
# חשבון 1 חובה. 2 ו-3 אופציונליים — הבוט נופל אליהם כשהתקציב של הראשון נגמר.
APIFY_TOKEN_1=
APIFY_TASK_ID_1=
APIFY_TOKEN_2=
APIFY_TASK_ID_2=
APIFY_TOKEN_3=
APIFY_TASK_ID_3=

# --- AI ---
# חובה אחד מהשניים. Gemini ראשי, Groq גיבוי.
GEMINI_API_KEY=
GROQ_API_KEY=

# ===========================================================================
# ערוצי התראה — מספיק להגדיר אחד. הסדר ב-config.NOTIFY_CHANNELS.
# ===========================================================================

# --- מייל (ברירת המחדל, הכי פחות שביר) ---
# ב-Gmail: SMTP_PASSWORD הוא App Password בן 16 תווים, לא סיסמת החשבון.
# נוצר ב-myaccount.google.com/apppasswords (דורש אימות דו-שלבי פעיל).
SMTP_USER=
SMTP_PASSWORD=
EMAIL_TO=
# ברירות מחדל ל-Gmail. לשנות רק אם משתמשים בספק אחר.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587

# --- ntfy.sh (פוש לנייד, בלי חשבון ובלי מפתח) ---
# שם ה"נושא" הוא הסוד היחיד — לבחור משהו ארוך ואקראי, לא "sapir-dirot".
# מתקינים את אפליקציית ntfy ונרשמים לאותו שם.
NTFY_TOPIC=
NTFY_SERVER=https://ntfy.sh

# --- וואטסאפ: מספר היעד (משותף ל-Green ול-CallMeBot) ---
# בפורמט בינלאומי בלי + ובלי מקפים. גם 0501234567 יעבוד — הקוד ממיר.
WHATSAPP_TO=

# --- וואטסאפ · Green API (ערוץ ראשי) ---
GREEN_API_INSTANCE_ID=
GREEN_API_TOKEN=
# רק אם Green נתנו לך כתובת ייעודית (למשל https://7103.api.greenapi.com).
# אם לא — להשאיר ריק, ברירת המחדל תעבוד.
GREEN_API_URL=

# --- וואטסאפ · CallMeBot (גיבוי, אופציונלי) ---
CALLMEBOT_APIKEY=

# --- טלגרם (גיבוי אחרון, אופציונלי) ---
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=
