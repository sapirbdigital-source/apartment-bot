# העתק ל-.env והשלם. ב-GitHub Actions אלה נכנסים כ-Secrets ולא כקובץ.

# --- Apify (סריקת קבוצות פייסבוק) ---
# חשבון 1 חובה. 2 ו-3 אופציונליים — הבוט נופל אליהם כשהתקציב של הראשון נגמר.
APIFY_TOKEN_1=
APIFY_TASK_ID_1=
APIFY_TOKEN_2=
APIFY_TASK_ID_2=
APIFY_TOKEN_3=
APIFY_TASK_ID_3=

# --- AI ---
# חובה אחד מהשניים. Gemini ראשי, Groq גיבוי.
GEMINI_API_KEY=
GROQ_API_KEY=

# --- וואטסאפ: מספר היעד (משותף לכל הערוצים) ---
# בפורמט בינלאומי בלי + ובלי מקפים. גם 0501234567 יעבוד — הקוד ממיר.
WHATSAPP_TO=972501234567

# --- וואטסאפ · Green API (ערוץ ראשי) ---
GREEN_API_INSTANCE_ID=
GREEN_API_TOKEN=
# רק אם Green נתנו לך כתובת ייעודית (למשל https://7103.api.greenapi.com).
# אם לא — להשאיר ריק, ברירת המחדל תעבוד.
GREEN_API_URL=

# --- וואטסאפ · CallMeBot (גיבוי, אופציונלי) ---
CALLMEBOT_APIKEY=

# --- טלגרם (גיבוי אחרון, אופציונלי) ---
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=
